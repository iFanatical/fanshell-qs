#!/bin/sh
# Link the shell's config files in config/ into $HOME. The session itself
# (.xinitrc, .X_envars, the window manager's config) is linked by the
# window manager's repo: fanoxwm-qs or fanqtile-qs.
#
#   tools/link-config            create or repair the links
#   tools/link-config --dry-run  show what would change
#
# Links point at this checkout, wherever it lives, so the same command sets
# up any machine. A real file in the way is moved aside to NAME.bak-DATE
# first; a link that already points here is left alone, so running it again
# is harmless (tools/lib.sh's link()).
set -eu

tools=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
. "$tools/lib.sh"
parse_dry_run "$@"

config_dir=$(CDPATH= cd -- "$tools/../config" && pwd)
config_home=${XDG_CONFIG_HOME:-$HOME/.config}

link "$config_dir/sxhkdrc" "$config_home/sxhkd/sxhkdrc"
link "$config_dir/picom.conf" "$config_home/picom/picom.conf"
link "$config_dir/alacritty.toml" "$config_home/alacritty/alacritty.toml"
# Only this file: the rest of ~/.config/fanshell-qs is state the shell writes
# (wallpaper.conf, vibrance.conf), which does not belong in the repo.
link "$config_dir/websites.json" "$config_home/fanshell-qs/websites.json"
link "$config_dir/outputs.defaults.conf" "$config_home/fanshell-qs/outputs.defaults.conf"
link "$config_dir/mouse.defaults.conf" "$config_home/fanshell-qs/mouse.defaults.conf"
link "$config_dir/xdg-desktop-portal/portals.conf" "$config_home/xdg-desktop-portal/portals.conf"
# Only where systemd is the init: fanshell-qs-session starts this target
# there, and nowhere else.
if [ -d /run/systemd/system ]; then
    link "$config_dir/systemd/fanshell-qs-session.target" \
        "$config_home/systemd/user/fanshell-qs-session.target"
fi
