#!/bin/sh
# fanshell-qs-lock — lock the screen.
#
# Used by the Lock button, the shell's lock on idle and lock before suspend.
# It returns once the screen is locked, so the shell can hold suspend until
# then. Locking twice does nothing.
#
# The lock screen is fanshell-qs-shell's own (`fanshell-qs-shell lock`; see
# shell/lockscreen.h): the clock over the blurred wallpaper, a password
# field, media controls. It needs a PAM service, /etc/pam.d/fanshell-qs-lock
# (tools/install-shell installs it) or i3lock's; when it cannot lock here at
# all it says so with status 2, and other lockers are tried instead.
set -eu

if command -v fanshell-qs-shell >/dev/null 2>&1; then
	status=0
	fanshell-qs-shell lock || status=$?
	# 1: it could not grab the keyboard or pointer; another locker could not
	# either.
	[ "$status" -eq 2 ] || exit "$status"
fi

if command -v i3lock >/dev/null 2>&1; then
	exec i3lock --ignore-empty-password --show-failed-attempts --color 1a1b26
fi
for locker in xsecurelock slock; do
	if command -v "$locker" >/dev/null 2>&1; then
		"$locker" &
		exit 0
	fi
done
if command -v xscreensaver-command >/dev/null 2>&1; then
	exec xscreensaver-command -lock
fi
# Only the standard "Lock" signal: nothing shows unless something listens.
exec loginctl lock-session
