# fanshell-qs-shell — hand-rolled C++/Qt bar for oxwm, qtile and Hyprland.
#
# Needs qtbase (widgets, gui, dbus, network) with the xcb platform plugin,
# libxcb (with RandR, DPMS and the screen saver extension, for displays,
# vibrance, screen power and lock on idle; XKB and XInput, for the
# keyboard settings), libpulse, X11/XComposite/XDamage/XFixes for the
# XEmbed tray, libxkbfile, which reads the XKB rules for the keyboard
# options as setxkbmap does, and PAM, for the lock screen's password.
#
# Fedora:  dnf install qt6-qtbase-devel pulseaudio-libs-devel libxcb-devel \
#                 libX11-devel libXcomposite-devel libXdamage-devel \
#                 libXfixes-devel libxkbfile-devel pam-devel
# Gentoo:  emerge dev-qt/qtbase media-libs/libpulse x11-libs/libxcb \
#                 x11-libs/libX11 x11-libs/libXcomposite x11-libs/libXdamage \
#                 x11-libs/libXfixes x11-libs/libxkbfile sys-libs/pam
#
# Hyprland (Wayland) support is built when layer-shell-qt and
# wayland-client are found, and left out otherwise; WAYLAND=0 leaves it out
# anyway. It also needs qtwayland at run time, xkbcommon, and the
# wayland-protocols and hyprland-protocols XML, turned into C by
# wayland-scanner:
#
# Fedora:  dnf install layer-shell-qt-devel qt6-qtwayland-devel \
#                 wayland-devel wayland-protocols-devel libxkbcommon-devel \
#                 hyprland-protocols-devel
# Gentoo:  emerge kde-plasma/layer-shell-qt dev-qt/qtwayland \
#                 dev-libs/wayland dev-libs/wayland-protocols \
#                 x11-libs/libxkbcommon dev-libs/hyprland-protocols

QTMODS   = Qt6Widgets Qt6Gui Qt6Core Qt6DBus Qt6Network
PKGS     = $(QTMODS) libpulse xcb xcb-randr xcb-dpms xcb-screensaver xcb-xkb \
           xcb-xinput x11 xcomposite xdamage xfixes xkbfile

# XEmbed tray intake. Optional under Wayland in fanhypr-qs; on X11 it is the
# native tray protocol, so it is always built here.
override CXXFLAGS += -DFANSHELL_QS_HAVE_XEMBED

# layer-shell-qt ships CMake config files, not a .pc, so it is found by hand.
# Distros disagree about where the headers land; take the first that exists,
# and include its *parent* so `#include <LayerShellQt/Window>` resolves.
LSQT_DIR ?= $(firstword $(wildcard \
              /usr/include/LayerShellQt \
              /usr/include/qt6/LayerShellQt \
              /usr/local/include/LayerShellQt))
WL_PKGS   = wayland-client xkbcommon
WAYLAND  ?= $(if $(LSQT_DIR),$(shell pkg-config --exists $(WL_PKGS) && echo 1))
# The Hyprland backend and the Wayland protocol clients.
WL_MODULES =
WL_MOCHDRS =
ifeq ($(WAYLAND),1)
PKGS     += $(WL_PKGS)
override CXXFLAGS += -DFANSHELL_QS_HAVE_WAYLAND \
                     -I$(patsubst %/,%,$(dir $(LSQT_DIR)))
override LDLIBS   += -lLayerShellQtInterface
WL_MODULES = hypripc hyprstate screenshader wlclient sessionlock
WL_MOCHDRS = hypripc hyprstate screenshader wlclient sessionlock
PKGS     += wayland-cursor
override CXXFLAGS += -Igen
# Video wallpapers, played by libmpv; without it a video shows its first
# frame. MPV=0 leaves it out.
MPV      ?= $(shell pkg-config --exists mpv Qt6OpenGLWidgets && echo 1)
ifeq ($(MPV),1)
PKGS     += mpv Qt6OpenGL Qt6OpenGLWidgets
override CXXFLAGS += -DFANSHELL_QS_HAVE_MPV
endif
endif

# Wayland protocol clients, generated by wayland-scanner into gen/: the
# ext-* ones from wayland-protocols, wlr-output-power-management (output
# power, which wlroots-style compositors such as Hyprland offer) from
# protocols/, where it is kept because no package installs it.
WL_PROTODIR = $(shell pkg-config --variable=pkgdatadir wayland-protocols 2>/dev/null)
WL_PROTOCOLS = \
    $(WL_PROTODIR)/staging/ext-session-lock/ext-session-lock-v1.xml \
    $(WL_PROTODIR)/staging/ext-idle-notify/ext-idle-notify-v1.xml \
    protocols/wlr-output-power-management-unstable-v1.xml
WL_GEN_H = $(patsubst %.xml,gen/%-client-protocol.h,$(notdir $(WL_PROTOCOLS)))
WL_GEN_O = $(patsubst %.xml,gen/%-protocol.o,$(notdir $(WL_PROTOCOLS)))
SCANNER ?= wayland-scanner
vpath %.xml $(sort $(dir $(WL_PROTOCOLS)))
ifeq ($(WAYLAND),1)
WL_OBJ = $(WL_GEN_O)
endif

gen/%-client-protocol.h: %.xml
	@mkdir -p gen
	$(SCANNER) client-header $< $@

gen/%-protocol.c: %.xml
	@mkdir -p gen
	$(SCANNER) private-code $< $@

gen/%-protocol.o: gen/%-protocol.c
	$(CC) -c -O2 -fPIC $(shell pkg-config --cflags wayland-client) -o $@ $<

CXX      ?= g++
MOC      ?= $(shell pkg-config --variable=libexecdir Qt6Core)/moc
# `override` so `make CXXFLAGS=-g` (or LDLIBS=...) adds to the required flags
# instead of replacing them -- a plain += is discarded for command-line vars.
override CXXFLAGS += -std=c++17 -O2 -Wall -fPIC \
                     $(shell pkg-config --cflags $(PKGS))
# PAM has no pkg-config file on every distribution; it is always libpam.
override LDLIBS   += $(shell pkg-config --libs $(PKGS)) -lpam

MODULES  = widgets popup surface procutil wmstate oxwmipc oxwmstate qtileipc \
           qtilestate calendar pills \
           panel network bluetooth volume tray traymenu desktopentry \
           launcher ipc clipboard system battery wallpaper notification osd \
           hardwarecontrols powerprofiles media menu xembedtray vibrance displays \
           controlpanel keyboard mouse idleinhibit lockscreen nightlight \
           gamemode status capture wallpapervideo $(WL_MODULES)
# headers containing Q_OBJECT classes
MOCHDRS  = widgets popup procutil wmstate oxwmipc oxwmstate qtilestate calendar \
           pills panel \
           network bluetooth volume tray traymenu desktopentry launcher ipc \
           clipboard system battery wallpaper notification osd \
           hardwarecontrols powerprofiles media xembedtray vibrance displays \
           idleinhibit nightlight gamemode status capture $(WL_MOCHDRS)

OBJ      = $(MODULES:%=%.o) main.o $(MOCHDRS:%=moc_%.o) $(WL_OBJ)

all: fanshell-qs-shell
ifneq ($(WAYLAND),1)
	@echo 'note: built without Hyprland (Wayland) support -- see the top of shell/Makefile'
endif

fanshell-qs-shell: $(OBJ)
	$(CXX) -o $@ $(OBJ) $(LDLIBS)

moc_%.cpp: %.h
	$(MOC) $< -o $@

%.o: %.cpp
	$(CXX) -c $(CXXFLAGS) -o $@ $<

$(OBJ): $(wildcard *.h)

# The flags the objects were compiled with. make tracks files, not flags, so
# without this a build with WAYLAND=1 after one without it compiled only the
# new files and linked them with objects built for X11 alone (the oxwm
# backend, plain windows instead of layer surfaces). The file changes only
# when the flags do, which rebuilds everything.
BUILD_FLAGS = $(CXX) $(CXXFLAGS) $(CC) | $(LDLIBS)
.build-flags: FORCE
	@printf '%s\n' '$(BUILD_FLAGS)' | cmp -s - $@ \
	    || printf '%s\n' '$(BUILD_FLAGS)' > $@
$(OBJ) fanshell-qs-shell: .build-flags
ifeq ($(WAYLAND),1)
$(MODULES:%=%.o) main.o: $(WL_GEN_H)
endif

clean:
	rm -f fanshell-qs-shell *.o moc_*.cpp .build-flags
	rm -rf gen

.PHONY: all clean FORCE
FORCE:
